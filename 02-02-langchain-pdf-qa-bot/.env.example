# Copy to .env - docker compose reads it automatically. All values are optional.
# For plain `python app.py` runs, export the variable in your shell instead.
# Leave OLLAMA_HOST unset for Docker (it defaults to http://host.docker.internal:11434).
# OLLAMA_HOST=http://my-gpu-box:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
QABOT_CHUNK_SIZE=500
QABOT_CHUNK_OVERLAP=75
QABOT_TOP_K=4
